        {
          "id": "3089f76b-bc2c-4ae2-82ba-1646246892bf",
          "name": "BrewPage Upload File",
          "request": {
            "name": "BrewPage Upload File",
            "description": {
              "content": "Stores a file via multipart upload and returns a download link. Only safe file types accepted. Reuse existing owner token to group entities under one owner",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "files"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ns",
                  "value": "public",
                  "description": "Namespace. Default: public. Pages in 'public' without password appear in gallery. Custom namespace is created automatically"
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Comma-separated tags"
                },
                {
                  "disabled": false,
                  "key": "ttl",
                  "value": "<string>",
                  "description": "Time to live in days (1-30, default 15). File auto-deletes after expiry. Accepts '15', '15d' or '15 days'"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Access password. Empty = public file visible in gallery. With password = hidden from gallery, viewers must enter password or pass ?p= in URL",
                "key": "X-Password",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Reuse existing owner token to group entities under one owner. If omitted, a new token is generated",
                "key": "X-Owner-Token",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
