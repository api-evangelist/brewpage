              },
              {
                "name": "tags",
                "value": "demo,test",
                "type": "query",
                "description": "Comma-separated tags"
              },
              {
                "name": "ttl",
                "value": "",
                "type": "query",
                "description": "Time to live in days (1-30, default 15). Document auto-deletes after expiry. Accepts '15', '15d' or '15 days'"
